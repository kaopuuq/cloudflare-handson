---
// すべてのページで共通の枠（<head>、ヘッダー、フッター）。
// 各ページの中身は<slot />の位置に入る。
interface Props {
	title: string;
}
const { title } = Astro.props;
---

<html lang="ja">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="stylesheet" href="/style.css" />
		<title>{title} | ひとこと掲示板</title>
	</head>
	<body>
		<header>
			<a class="brand" href="/">ひとこと掲示板</a>
			<nav>
				<a href="/">トップ</a>
				<a href="/about">このサイトについて</a>
			</nav>
		</header>
		<main>
			<slot />
		</main>
		<footer>Cloudflareハンズオン用のデモです</footer>
	</body>
</html>
