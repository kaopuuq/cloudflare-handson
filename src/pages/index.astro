---
import Layout from '../layouts/Layout.astro';

// 段階Aでは、投稿をコードに直接書いておく。
// 段階Cで、この部分をD1から読み込む形に置き換える。
const posts = [
	{ name: 'さくら', message: 'はじめまして！', createdAt: '2026-11-01 10:00' },
	{ name: 'たろう', message: 'Cloudflare Pagesで公開してみました。', createdAt: '2026-11-02 18:30' },
];
---

<Layout title="トップ">
	<h1>ひとこと掲示板</h1>
	<p class="lead">ひとことを残していってください。</p>

	<ul class="posts">
		{
			posts.map((post) => (
				<li>
					<p class="message">{post.message}</p>
					<p class="meta">
						{post.name}・{post.createdAt}
					</p>
				</li>
			))
		}
	</ul>
</Layout>
